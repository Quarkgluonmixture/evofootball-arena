node_modules/
dist/
*.log
.DS_Store
release/

# REAPER waveform cache — editor junk, never versioned
audio/audio_raw/peaks/
*.reapeaks

# derived audio (rebuilt by scripts/audio/clean.py)
audio/processed/*.wav

# audio sources (audio/) are tracked since 2026-08-18 so they survive machine
# migration; only editor caches (above) and derived wav (above) stay ignored.

# Claude Code workspace. Only the agent definitions are shared — scratch output and
# the registered worktrees under .claude/worktrees/ are ~105MB of build artefacts and
# in-progress branches that must never reach this public repo.
.claude/*
!.claude/agents/
